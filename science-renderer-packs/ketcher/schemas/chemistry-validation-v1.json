{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentlas.science/chemistry-validation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine", "engineVersion", "validator", "validatorVersion", "ketSha256", "canonicalSmilesSha256", "atomCount", "bondCount", "warnings", "code"],
  "properties": {
    "schema": { "const": "agentlas.science-chemistry-validation/v1" },
    "engine": { "const": "Ketcher" },
    "engineVersion": { "const": "3.17.2" },
    "validator": { "const": "Indigo" },
    "validatorVersion": { "const": "1.45.1" },
    "ketSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalSmilesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "atomCount": { "type": "integer", "minimum": 1 },
    "bondCount": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "code": { "const": "structure-valid" }
  }
}
