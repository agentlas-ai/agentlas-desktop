{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-medchem",
  "name": "Agentlas Medchem",
  "version": "0.1.0",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.cloud"
  },
  "keywords": [
    "RDKit",
    "molecular properties",
    "drug-likeness",
    "Lipinski",
    "rule of five",
    "QED",
    "PAINS",
    "SMILES",
    "standardization",
    "cheminformatics",
    "compound grid",
    "medicinal chemistry",
    "분자 물성",
    "약물유사성",
    "리핀스키",
    "화학 구조",
    "SMILES 정규화",
    "화합물 비교"
  ],
  "surface": {
    "displayName": "Medchem",
    "displayNameKo": "의약화학",
    "tagline": "RDKit properties, drug-likeness, alerts, SMILES standardization and compound grids",
    "taglineKo": "RDKit 분자 물성·약물유사성·구조 경고·SMILES 정규화·화합물 격자 그림",
    "description": "Compute molecular properties and drug-likeness (MW, cLogP, TPSA, HBD/HBA, QED, Lipinski/Veber/Egan/Ghose), flag PAINS and Brenk alerts, standardize SMILES and draw labelled compound grids with RDKit running in the plugin's own managed Python environment.",
    "descriptionKo": "플러그인 전용 관리형 Python 환경의 RDKit 으로 분자 물성과 약물유사성(MW, cLogP, TPSA, HBD/HBA, QED, Lipinski/Veber/Egan/Ghose)을 계산하고 PAINS·Brenk 경고, SMILES 정규화, 화합물 격자 그림을 만듭니다.",
    "category": "data",
    "brandColor": "#7A3E9D",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "sotorasib 과 adagrasib 의 분자 물성과 약물유사성을 비교표로 보여줘",
      "이 SMILES 들을 정규화하고 염을 제거해줘",
      "KRAS G12C 저해제들의 화학 구조를 한 그림에 그려줘"
    ]
  },
  "invocation": {
    "mention": "@agentlas-medchem",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "properties",
        "structures"
      ]
    },
    "tools": [
      {
        "id": "agentlas-medchem",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/runtime/mcp-server.cjs"
        ],
        "envKeys": [],
        "timeoutMs": 90000,
        "surface": {
          "name": "Agentlas 의약화학",
          "nameEn": "Agentlas Medchem",
          "description": "compute_molecular_properties·standardize_smiles·draw_compound_grid·describe_medchem_runtime: RDKit 분자 물성·약물유사성·구조 경고, SMILES 정규화, 화합물 격자 그림",
          "descriptionEn": "compute_molecular_properties, standardize_smiles, draw_compound_grid, describe_medchem_runtime: RDKit molecular properties, drug-likeness (Lipinski, QED), structural alerts, SMILES standardization, compound grids (분자 물성, 약물유사성, 화학 구조)",
          "category": "data",
          "brandColor": "#7A3E9D",
          "mark": "MC",
          "docsUrl": "https://www.rdkit.org/docs/"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      },
      {
        "id": "python",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "project-only",
    "network": "allow",
    "shell": "deny"
  },
