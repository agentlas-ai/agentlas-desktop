{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-comparative-genomics",
  "name": "Agentlas Comparative Genomics",
  "version": "0.2.0",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.ai"
  },
  "surface": {
    "displayName": "Comparative Genomics",
    "displayNameKo": "비교유전체학",
    "tagline": "Version-pinned extant assemblies, gene trees, and alignments",
    "taglineKo": "버전이 고정된 현생종 참조 유전체·유전자 계통수·정렬",
    "description": "Pins Ensembl extant reference assemblies to exact accessions and provider FASTA checksums, retrieves exact Compara gene trees and alignments, and preserves scientific evidence boundaries without inventing an extinct genome.",
    "descriptionKo": "Ensembl 현생종 참조 유전체를 정확한 accession과 제공자 FASTA 체크섬에 고정하고 Compara gene tree·정렬을 가져오며, 멸종종 유전체를 발명하지 않고 과학적 증거 경계를 보존합니다.",
    "category": "data",
    "brandColor": "#386A63",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "이 Ensembl 유전자의 조류 계통 gene tree와 정렬 QC 표를 만들어줘",
      "이 계통수의 duplication과 낮은 support branch를 표시하고 논문용 그림으로 만들어줘",
      "현생종 cDNA 정렬의 내부 노드 하나를 골라 탐색적 Fitch ambiguity set을 계산해줘",
      "조류와 악어류 현생종을 선택해 멸종종 추론 없이 locus panel QC를 만들어줘"
    ]
  },
  "invocation": {
    "mention": "@agentlas-comparative-genomics",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "reference-assembly-manifest",
        "ensembl-compara-gene-tree",
        "alignment-qc",
        "hypothetical-asr-fitch",
        "extant-archosaur-locus-panel"
      ]
    },
    "tools": [
      {
        "id": "agentlas-comparative-genomics",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/runtime/mcp-server.cjs"
        ],
        "envKeys": [],
        "timeoutMs": 60000,
        "surface": {
          "name": "Agentlas 비교유전체학",
          "nameEn": "Agentlas Comparative Genomics",
          "description": "Ensembl Compara gene tree·정렬과 증거 경계를 ResearchRun으로 봉인",
          "descriptionEn": "Seal Ensembl Compara gene trees, alignments, and evidence boundaries into ResearchRuns",
          "category": "data",
          "brandColor": "#386A63",
          "mark": "CG",
          "docsUrl": "https://rest.ensembl.org/documentation/info/genetree_species_member_id"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "allow",
    "shell": "deny"
  },
