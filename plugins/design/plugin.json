{
  "schema": "agentlas.plugin/v2",
  "slug": "design",
  "name": "Agentlas Design",
  "version": "0.2.0",
  "builtin": true,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.cloud"
  },
  "surface": {
    "displayName": "Agentlas Design",
    "displayNameKo": "Agentlas 디자인",
    "tagline": "Visual-first design ideation, faithful prototyping, and Apple HIG-grounded design review",
    "taglineKo": "시각적 시안 탐색, 1:1 프로토타입 구현, 그리고 Apple 휴먼 인터페이스 가이드라인 기반 디자인 리뷰",
    "description": "Close the gap between product ideas and working software with rapid 3-concept visual ideation, target pinning, faithful side-by-side prototyping, UI motion engineering, and design reviews graded against Apple's Human Interface Guidelines.",
    "descriptionKo": "시각적 3종 시안 생성, 타겟 시안 고정, 시안 기반 1:1 대조 프로토타입 구현, UI 모션 엔지니어링, 그리고 Apple 휴먼 인터페이스 가이드라인 171개 문서를 근거로 한 디자인 리뷰·접근성 감사를 제공합니다.",
    "category": "design",
    "brandColor": "#FF66AD",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "Generate 3 distinct visual design concepts for this idea",
      "Review this screen against Apple's Human Interface Guidelines",
      "Audit the accessibility of this app and grade what you find",
      "Recreate this screen into an interactive web prototype",
      "Add smooth spring physics and micro-interactions to this component"
    ]
  },
  "invocation": {
    "mention": "@design",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "get-context",
        "user-context",
        "ideate",
        "audit",
        "hig-review",
        "image-to-code",
        "motion",
        "url-to-code",
        "research",
        "design-qa",
        "share",
        "seed-design",
        "app-context"
      ]
    }
  },
  "requires": {
    "tools": [
      "browser"
    ],
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "project-only",
    "network": "ask",
    "shell": "deny"
  },
  "state": {
    "files": [
      "user-context.md"
    ],
    "assets": true
  },
