{
  "tools": [
    {
      "name": "search_oqmd_optimade_structures",
      "description": "Search the anonymous OQMD OPTIMADE v1 structures endpoint by an exact set of element symbols. Uses a three-attempt total-deadline policy, validates JSON MIME and every returned element set, and returns normalized structures plus a standalone response receipt. This direct MCP receipt is not immutable host Science persistence; use search_materials_structures in Agentlas Science when a ResearchRun, Source, and artifact must be committed.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elements"],
        "properties": {
          "elements": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][a-z]?$", "maxLength": 2 } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
          "offset": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 0 }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["schema", "structureCount", "structures", "table", "normalizedSha256", "query", "provenance"],
        "properties": {
          "schema": { "const": "agentlas.materials.oqmd-optimade/v1" },
          "structureCount": { "type": "integer", "minimum": 0, "maximum": 50 },
          "structures": { "type": "array", "maxItems": 50 },
          "table": { "type": "object" },
          "normalizedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "query": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elements", "limit", "offset"],
            "properties": {
              "elements": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
              "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
              "offset": { "type": "integer", "minimum": 0, "maximum": 10000 }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "evidenceScope", "hostPersisted", "attemptCount", "attempts", "provider", "request", "response", "retrievedAt", "license", "docsUrl", "hostPersistenceRequirement"],
            "properties": {
              "schema": { "const": "agentlas.materials.oqmd-retrieval/v2" },
              "evidenceScope": { "const": "standalone-response-only" },
              "hostPersisted": { "const": false },
              "attemptCount": { "type": "integer", "minimum": 1, "maximum": 3 },
              "attempts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["attempt", "status", "contentType", "mimeType", "byteLength", "rawSha256", "bodyComplete", "retrievedAt", "retryable", "willRetry", "retryAfterMs", "errorCode"],
                  "properties": {
                    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
                    "status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
                    "contentType": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
                    "mimeType": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
                    "byteLength": { "type": "integer", "minimum": 0, "maximum": 8388609 },
                    "rawSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
                    "bodyComplete": { "type": "boolean" },
                    "retrievedAt": { "type": "string" },
                    "retryable": { "type": "boolean" },
                    "willRetry": { "type": "boolean" },
                    "retryAfterMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 5000 },
                    "errorCode": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 }
                  },
                  "allOf": [
                    { "if": { "properties": { "bodyComplete": { "const": true } } }, "then": { "properties": { "rawSha256": { "type": "string" } } }, "else": { "properties": { "rawSha256": { "const": null } } } },
                    { "if": { "properties": { "willRetry": { "const": true } } }, "then": { "properties": { "retryAfterMs": { "type": "integer" } } }, "else": { "properties": { "retryAfterMs": { "const": null } } } }
                  ]
                }
              },
              "provider": { "const": "OQMD OPTIMADE" },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "url", "descriptorSha256"],
                "properties": {
                  "method": { "const": "GET" },
                  "url": { "type": "string" },
                  "descriptorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              },
              "response": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rawSha256", "byteLength", "mimeType"],
                "properties": {
                  "rawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "byteLength": { "type": "integer", "minimum": 2, "maximum": 8388608 },
                  "mimeType": { "type": "string", "enum": ["application/json", "application/vnd.api+json"] }
                }
              },
              "retrievedAt": { "type": "string" },
              "license": { "const": "CC-BY-4.0" },
              "docsUrl": { "type": "string" },
              "hostPersistenceRequirement": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "name": "search_cod_crystals",
      "description": "Bounded COD metadata search. Supply either 1-20 seven-digit COD IDs or one 1-8-element space-separated Hill-style formula. A count request runs first; JSON is not fetched when matches exceed maxMatches.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          { "required": ["ids"], "not": { "required": ["formula"] } },
          { "required": ["formula"], "not": { "required": ["ids"] } }
        ],
        "properties": {
          "ids": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{7}$" } },
          "formula": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Z][A-Za-z0-9. ]*$" },
          "maxMatches": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
        }
      }
    },
    {
      "name": "fetch_cod_cif",
      "description": "Fetch one exact COD CIF, optionally at a COD revision. Preserves the exact UTF-8 CIF and byte hash, plus conservative cell and deposited asymmetric-unit atom-site normalization for a host 3Dmol renderer.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codId"],
        "properties": {
          "codId": { "type": "string", "pattern": "^[0-9]{7}$" },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    {
      "name": "analyze_lattice_metrics",
      "description": "Validate and compute lattice-cell volume from a hash-verified normalized COD CIF or OQMD OPTIMADE structure. CIF volume uses the triclinic cell formula; OPTIMADE volume uses the absolute lattice determinant. Density is computed only when explicit composition, formula-units Z, and formula weight are all present; none are inferred.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKind", "normalized"],
        "properties": {
          "sourceKind": { "type": "string", "enum": ["cod-cif", "optimade"] },
          "normalized": { "type": "object", "required": ["schema", "normalizedSha256"] },
          "structureId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "declaredVolumeToleranceRelative": { "type": "number", "minimum": 0, "maximum": 0.1, "default": 0.005 }
        }
      }
    },
    {
      "name": "describe_materials_science_capabilities",
      "description": "Return exact provider, guard, data-contract, renderer, and limitation declarations for this plugin.",
      "inputSchema": { "type": "object", "additionalProperties": false, "properties": {} }
    }
  ]
}
