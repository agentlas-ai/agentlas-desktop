{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-materials-science",
  "name": "Agentlas Materials Science",
  "version": "0.2.2",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.ai"
  },
  "surface": {
    "displayName": "Materials Science",
    "displayNameKo": "재료과학",
    "tagline": "Provenanced structures from OQMD and COD",
    "taglineKo": "OQMD와 COD 구조를 원문 출처와 함께 탐색",
    "description": "Searches OQMD and COD structures, preserves exact structural lineage, and computes validated lattice volume plus density only from complete explicit crystallographic inputs.",
    "descriptionKo": "OQMD·COD 구조와 정확한 계보를 보존하고 검증된 격자 부피 및 명시적 결정 입력이 완전할 때만 밀도를 계산합니다.",
    "category": "data",
    "brandColor": "#6657A8",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "이 원소 조합의 OQMD 구조를 찾고 격자·좌표·밴드갭을 비교해줘",
      "이 COD 결정 레코드를 확인하고 원본 CIF를 3D 구조 아티팩트로 열어줘",
      "이 CIF 또는 OPTIMADE 구조의 격자 부피를 검증하고 명시값이 충분할 때만 밀도를 계산해줘"
    ]
  },
  "invocation": {
    "mention": "@agentlas-materials-science",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "optimade-structures",
        "cod-crystals",
        "lattice-metrics"
      ]
    },
    "tools": [
      {
        "id": "agentlas-materials-science",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/runtime/mcp-server.cjs"
        ],
        "envKeys": [],
        "timeoutMs": 45000,
        "surface": {
          "name": "Agentlas 재료과학 데이터",
          "nameEn": "Agentlas Materials Science Data",
          "description": "OQMD·COD 구조를 정규화하고 해시 검증된 격자 부피 및 조건부 밀도를 계산",
          "descriptionEn": "Normalize OQMD and COD structures and compute hash-verified lattice volume and conditional density",
          "category": "data",
          "brandColor": "#6657A8",
          "mark": "MS",
          "docsUrl": "https://www.oqmd.org/optimade/"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "allow",
    "shell": "deny"
  },
