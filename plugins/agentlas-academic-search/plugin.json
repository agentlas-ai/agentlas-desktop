{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-academic-search",
  "name": "Academic Search",
  "version": "1.1.0",
  "builtin": true,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.cloud"
