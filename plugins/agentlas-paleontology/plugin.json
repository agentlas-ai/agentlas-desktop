{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-paleontology",
  "name": "Agentlas Paleontology",
  "version": "0.2.0",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.ai"
  },
  "surface": {
    "displayName": "Paleontology",
    "displayNameKo": "고생물학",
    "tagline": "Evidence-bounded fossil occurrence research",
    "taglineKo": "증거 경계가 보존되는 화석 산출 연구",
    "description": "Retrieves and compares exact PBDB taxon, fossil-occurrence, and stratigraphic evidence without caller scores or biological-feasibility claims.",
    "descriptionKo": "PBDB 분류·화석 산출·지층 근거를 정확히 비교하며 호출자 점수나 생물학적 가능성 주장으로 승격하지 않습니다.",
    "category": "data",
    "brandColor": "#8A6846",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "PBDB에서 이 분류군의 화석 산출 기록과 지층 연대 범위를 찾아줘",
      "이 화석 기록이 실제로 지지하는 주장과 지지하지 못하는 주장을 나눠줘",
      "여러 후보의 PBDB catalog와 지층 분석을 정확히 묶어 화석 근거만 비교해줘"
    ]
  },
  "invocation": {
    "mention": "@agentlas-paleontology",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "pbdb-occurrences",
        "stratigraphic-support",
        "deextinction-feasibility"
      ]
    },
    "tools": [
      {
        "id": "agentlas-paleontology",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/runtime/mcp-server.cjs"
        ],
        "envKeys": [],
        "timeoutMs": 45000,
        "surface": {
          "name": "Agentlas 고생물학 데이터",
          "nameEn": "Agentlas Paleontology Data",
          "description": "PBDB 화석 분류·산출·지층 기록을 증거 경계와 함께 정규화",
          "descriptionEn": "Normalize PBDB fossil taxon, occurrence, and stratigraphic records with explicit evidence boundaries",
          "category": "data",
          "brandColor": "#8A6846",
          "mark": "PA",
          "docsUrl": "https://paleobiodb.org/data1.2/"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "allow",
    "shell": "deny"
  },
