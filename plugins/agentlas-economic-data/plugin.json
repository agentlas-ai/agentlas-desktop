{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-economic-data",
  "name": "Agentlas Economic Data",
  "version": "1.0.0",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.ai"
  },
  "surface": {
    "displayName": "Agentlas Economic Data",
    "displayNameKo": "Agentlas 경제 데이터",
    "tagline": "Reproducible official World Bank indicator series",
    "taglineKo": "재현 가능한 공식 World Bank 지표 시계열",
    "description": "Fetch one bounded World Bank indicator series with normalized missing values, provider metadata, pagination, and exact-response provenance.",
    "descriptionKo": "단일 World Bank 지표 시계열을 제한된 범위로 조회하고 결측값, 제공자 메타데이터, 페이지네이션, 원본 응답 출처 정보를 정규화합니다.",
    "category": "data",
    "brandColor": "#1F6E5A",
    "defaultPrompts": [
      "한국의 최근 GDP 지표를 World Bank 공식 데이터로 조회해줘",
      "이 국가의 World Bank 지표 시계열과 원본 응답 해시를 보여줘"
    ]
  },
  "invocation": {
    "mention": "@agentlas-economic-data",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "fetch-world-bank-indicator"
      ]
    },
    "tools": [
      {
        "id": "agentlas-economic-data",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/bin/world-bank-mcp.mjs"
        ],
        "envKeys": [],
        "timeoutMs": 30000,
        "surface": {
          "name": "경제 데이터",
          "nameEn": "Economic Data",
          "description": "공식 World Bank 지표를 키 없이 제한된 읽기 전용 요청으로 조회",
          "descriptionEn": "Fetch official World Bank indicators through bounded, keyless, read-only requests",
          "category": "data",
          "brandColor": "#1F6E5A",
          "mark": "ED",
          "docsUrl": "https://datahelpdesk.worldbank.org/knowledgebase/articles/889392-about-the-indicators-api-documentation"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "allow",
    "shell": "deny"
  },
  "state": {
    "files": [],
    "assets": false
  },
