{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "agentlas.mcp-tools/v1",
  "tools": [
    {
      "name": "fetch_world_bank_indicator",
      "title": "Fetch World Bank Indicator",
      "description": "Fetch one official World Bank indicator for one ISO country or approved aggregate and a bounded year range. No API key is used.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country", "indicator", "startYear", "endYear"],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}$",
            "description": "ISO 3166 alpha-2/alpha-3 country code or an approved World Bank aggregate code."
          },
          "indicator": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+){1,7}$",
            "description": "One dot-delimited World Bank indicator code, for example NY.GDP.MKTP.CD."
          },
          "startYear": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2200
          },
          "endYear": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2200
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1000
          }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/indicatorResult"
      }
    },
    {
      "name": "describe_economic_data_capabilities",
      "title": "Describe Economic Data Capabilities",
      "description": "Return the provider, authentication, network, input, normalization, and resource-limit contract for this plugin.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "$defs": {
    "indicatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "provider", "pagination", "series", "observations", "query", "request", "raw"],
      "properties": {
        "schema": {
          "const": "agentlas.economic-data.world-bank-indicator.v1"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "apiVersion", "sourceId", "lastUpdated"],
          "properties": {
            "id": { "const": "world-bank" },
            "name": { "const": "World Bank" },
            "apiVersion": { "const": "v2" },
            "sourceId": { "type": ["string", "null"] },
            "lastUpdated": { "type": ["string", "null"] }
          }
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "pages", "perPage", "total"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "pages": { "type": "integer", "minimum": 0 },
            "perPage": { "type": "integer", "minimum": 1 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "series": {
          "type": "object",
          "additionalProperties": false,
          "required": ["country", "indicator", "unit", "decimals"],
          "properties": {
            "country": { "type": ["object", "null"] },
            "indicator": { "type": ["object", "null"] },
            "unit": { "type": ["string", "null"] },
            "decimals": { "type": ["integer", "null"], "minimum": 0, "maximum": 12 }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "value", "unit", "decimals", "observationStatus"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}$" },
              "value": { "type": ["number", "null"] },
              "unit": { "type": "string" },
              "decimals": { "type": "integer", "minimum": 0, "maximum": 12 },
              "observationStatus": { "type": ["string", "null"] }
            }
          }
        },
        "query": { "type": "object" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://api\\.worldbank\\.org/v2/" }
          }
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "sha256"],
          "properties": {
            "bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
