{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-astronomy",
  "name": "Agentlas Astronomy",
  "version": "1.2.2",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.ai"
  },
  "surface": {
    "displayName": "Astronomy",
    "displayNameKo": "천문학",
    "tagline": "Provenanced SIMBAD search, stellar kinematics, and irregular light-curve periodicity",
    "taglineKo": "출처가 보존되는 SIMBAD 검색·항성 운동학·불규칙 광도곡선 주기 분석",
    "description": "Queries the anonymous official SIMBAD TAP object database and deterministically derives uncertainty-aware stellar kinematics or bounded generalized Lomb-Scargle periodograms, publication tables, and Vega-Lite FigureSpecs without imputing missing measurements.",
    "descriptionKo": "익명 공식 SIMBAD TAP 천체 데이터베이스를 조회하고 결측값을 보간하지 않으면서 불확실성 기반 항성 운동학 또는 제한된 generalized Lomb-Scargle 주기도, 출판용 표, Vega-Lite FigureSpec을 결정론적으로 계산합니다.",
    "category": "data",
    "brandColor": "#14213D",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "이 ICRS 좌표 주변 SIMBAD 천체를 찾고 분류와 측정값을 비교해줘",
      "이 좁은 원뿔 영역의 SIMBAD 천체를 출처 해시와 함께 표로 정리해줘",
      "이 시차·고유운동 측정표에서 거리와 접선속도를 오차 전파해 논문용 표와 그림으로 만들어줘",
      "이 불규칙 광도곡선의 시간계와 오차를 보존해서 Lomb-Scargle 주기도와 위상 접힘 그림을 만들어줘"
    ]
  },
  "invocation": {
    "mention": "@agentlas-astronomy",
    "implicit": "router",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "simbad-catalog",
        "astrometric-kinematics",
        "light-curve-periodicity"
      ]
    },
    "tools": [
      {
        "id": "agentlas-astronomy",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/runtime/mcp-server.cjs"
        ],
        "envKeys": [],
        "timeoutMs": 60000,
        "surface": {
          "name": "Agentlas 천문학 데이터",
          "nameEn": "Agentlas Astronomy Data",
          "description": "공식 SIMBAD 조회·오차 기반 항성 운동학·불규칙 광도곡선 주기 분석을 원문·계산 해시와 함께 정규화",
          "descriptionEn": "Normalize official SIMBAD queries, uncertainty-aware stellar kinematics, and bounded irregular light-curve periodicity with exact source and calculation hashes",
          "category": "data",
          "brandColor": "#14213D",
          "mark": "AS",
          "docsUrl": "https://simbad.cds.unistra.fr/Pages/guide/sim-url.htx"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "allow",
    "shell": "deny"
  },
