  "surface": {
    "displayName": "Earth Science",
    "displayNameKo": "지구과학",
    "tagline": "USGS and NOAA observations with reproducible provenance",
    "taglineKo": "USGS·NOAA 관측과 재현 가능한 출처",
    "description": "Queries official USGS earthquake and NOAA CO-OPS observed water-level APIs and performs bounded Gutenberg–Richter and Omori–Utsu analyses while preserving exact network/raw/normalized receipts, units, selections, tables, and figure payloads.",
    "descriptionKo": "공식 USGS 지진 및 NOAA CO-OPS 관측 수위 API를 조회하고 제한된 Gutenberg–Richter·Omori–Utsu 분석을 수행하며 정확한 네트워크·원문·정규화 영수증, 단위, 선택 내역, 표와 그림 페이로드를 보존합니다.",
    "category": "data",
    "brandColor": "#2E6F62",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "이 기간과 지역의 USGS 지진 관측을 불러와 지도와 분석용 표로 정리해줘",
      "완전한 USGS 카탈로그와 내가 정한 Mc로 규모-빈도 b값, 포함 감사표, 출판용 그림을 만들어줘",
      "이 여진 카탈로그에서 메인쇼크·관측창·완전성 경계를 명시해 Omori–Utsu p, c, K와 잔차 그림을 만들어줘",
      "이 USGS 사건의 진원·규모 불확실성과 관측 품질을 상세 분석해줘",
      "이 NOAA CO-OPS 관측소의 수위를 UTC·수직 기준면·단위와 함께 시계열로 정리해줘",
      "이 USGS GeoJSON을 정규화하고 출처 영수증을 만들어줘"
    ]
  },
  "invocation": { "mention": "@agentlas-earth-science", "implicit": "router", "standalone": true },
  "provides": {
    "skills": { "router": "skills/index/SKILL.md", "workflows": ["earthquake-catalog", "gutenberg-richter-analysis", "omori-utsu-analysis", "noaa-coops-water-level"] },
    "tools": [
      {
        "id": "agentlas-earth-science",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": ["${pluginDir}/runtime/mcp-server.cjs"],
        "envKeys": [],
        "timeoutMs": 20000,
        "surface": {
          "name": "Agentlas 지구과학 데이터",
          "nameEn": "Agentlas Earth Science Data",
          "description": "USGS 지진과 NOAA CO-OPS 관측 수위를 정규화하고, 명시적 경계 기반 Gutenberg–Richter·Omori–Utsu 분석·출판 표·그림·출처 영수증을 생성",
          "descriptionEn": "Normalize official USGS earthquake and NOAA CO-OPS observations and produce explicit-boundary Gutenberg–Richter and Omori–Utsu analyses, publication tables, figures, and provenance receipts",
          "category": "data",
          "brandColor": "#2E6F62",
          "mark": "ES",
          "docsUrl": "https://api.tidesandcurrents.noaa.gov/api/prod/"
        }
      }
    ]
  },
  "requires": { "prereq": [{ "id": "node", "provided-by": "app" }], "os": ["darwin", "win32", "linux"] },
