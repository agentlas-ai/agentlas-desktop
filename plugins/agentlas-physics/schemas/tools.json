{
  "schema": "agentlas.science-domain-tools/v1",
  "tools": [
    {
      "name": "search_inspire_literature",
      "description": "Search the anonymous INSPIRE REST API for high-energy-physics literature and return deterministic metadata, provider total/next-page state, and a provenance receipt.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 2, "maxLength": 500 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
          "sort": { "type": "string", "enum": ["relevance", "mostrecent", "mostcited"], "default": "relevance" }
        }
      }
    },
    {
      "name": "fetch_hepdata_record",
      "description": "Fetch public HEPData record metadata and optionally its table resource catalog; table bodies remain separately normalized inputs.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId"],
        "properties": {
          "recordId": { "type": "string", "pattern": "^ins[0-9]{1,16}$" },
          "version": { "type": "integer", "minimum": 1, "maximum": 999 },
          "includeTables": { "type": "boolean", "default": false }
        }
      }
    },
    {
      "name": "fetch_hepdata_table",
      "description": "Fetch one public HEPData JSON table from the official required-version download route and preserve missing measurements, bin bounds, qualifiers, and renderer-ready symmetric, asymmetric, relative, or one-sided error components.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "tableName", "version"],
        "properties": {
          "recordId": { "type": "string", "pattern": "^ins[0-9]{1,16}$" },
          "tableName": { "type": "string", "minLength": 1, "maxLength": 500 },
          "version": { "type": "integer", "minimum": 1, "maximum": 999 }
        }
      }
    },
    {
      "name": "normalize_hepdata_table",
      "description": "Normalize a user-supplied HEPData JSON table offline, preserving inclusive/no-x measurements, missing sentinels, qualifiers, and separate renderer-ready uncertainty components.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "tableName", "table"],
        "properties": {
          "recordId": { "type": "string", "pattern": "^ins[0-9]{1,16}$" },
          "tableName": { "type": "string", "minLength": 1, "maxLength": 500 },
          "version": { "type": "integer", "minimum": 1, "maximum": 999 },
          "table": { "type": "object" }
        }
      }
    },
    {
      "name": "analyze_hepdata_chi_square",
      "description": "Run a deterministic diagonal chi-square comparison against one normalized HEPData series. The caller explicitly selects independent uncertainty labels; asymmetric errors use the side toward the prediction. Returns residuals, pulls, a publication table, Vega-Lite payloads, p-value, and exact input/output hashes. Correlated errors are not inferred.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "dependentSeriesIndex", "prediction", "uncertaintyLabels"],
        "properties": {
          "table": { "type": "object", "required": ["schema", "normalizedBytes", "normalizedSha256"] },
          "dependentSeriesIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
          "prediction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "units", "values"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 300 },
              "units": { "type": ["string", "null"], "maxLength": 160 },
              "values": { "type": "array", "maxItems": 10000, "items": { "type": ["number", "null"] } }
            }
          },
          "uncertaintyLabels": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "fittedParameterCount": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 }
        }
      }
    },
    {
      "name": "normalize_physics_dataset",
      "description": "Normalize a bounded user numeric/string table for a Physics study; rejects truncation, row-width drift, non-finite numbers, and oversized payloads.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "columns", "rows"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                "type": { "type": "string", "enum": ["number", "string"] },
                "unit": { "type": "string", "maxLength": 120 }
              }
            }
          },
          "rows": { "type": "array", "maxItems": 10000, "items": { "type": "array", "maxItems": 64 } }
        }
      }
    },
    {
      "name": "describe_physics_capabilities",
      "description": "Return the exact implemented source, output, renderer, and unsupported-feature boundaries for this plugin.",
      "inputSchema": { "type": "object", "additionalProperties": false, "properties": {} }
    }
  ]
}
