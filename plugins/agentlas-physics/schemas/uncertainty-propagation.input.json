{
  "type": "object",
  "properties": {
    "expression": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Closed-form model y = f(variables) using + - * / ^, parentheses, pi, e, and sin cos tan asin acos atan atan2 sinh cosh tanh exp log ln log10 log2 sqrt cbrt abs pow hypot min max. Provide exactly one of expression or formula." },
    "formula": { "type": "string", "enum": ["pendulum_g", "ohm_resistance", "free_fall_g", "kinetic_energy", "cylinder_density", "refractive_index_snell", "lens_focal_length", "projectile_range", "spring_constant", "resistivity", "young_modulus", "specific_heat"], "description": "Catalogue formula id; its variables must be declared in variables." },
    "variables": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 64 },
          "value": { "type": "number" },
          "sigma": { "type": "number", "minimum": 0, "description": "Standard uncertainty (1σ)." },
          "unit": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Informational label; not checked." },
          "distribution": { "type": "string", "enum": ["normal", "uniform"], "default": "normal", "description": "uniform uses half-width sigma·√3 so sigma stays the standard deviation." }
        },
        "required": ["name", "value", "sigma"],
        "additionalProperties": false
      }
    },
    "correlation": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "number", "minimum": -1, "maximum": 1 } }, "description": "Square correlation matrix in variables order; symmetric, unit diagonal, positive definite." },
    "options": {
      "type": "object",
      "properties": {
        "samples": { "type": "integer", "minimum": 1000, "maximum": 200000, "default": 20000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 20240901 },
        "result_unit": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Informational label for the result." }
      },
      "additionalProperties": false
    }
  },
  "required": ["variables"],
  "additionalProperties": false
}
