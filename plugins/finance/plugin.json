{
  "schema": "agentlas.plugin/v2",
  "slug": "finance",
  "name": "Agentlas Finance",
  "version": "0.2.0",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.cloud"
  },
  "surface": {
    "displayName": "Agentlas Finance",
    "displayNameKo": "Agentlas Finance",
    "tagline": "Research assets and edit Finance dashboards, reports and monitors",
    "taglineKo": "종목을 조사하고 Finance 화면·보고서·모니터를 관리합니다",
    "description": "Search actual provider sources, save evidence, edit the authenticated Finance workspace and run research monitors from One or Work. Coverage and host availability are returned with each result.",
    "descriptionKo": "One·Work에서 실제 제공자 자료를 검색하고 근거를 저장하며 Finance 화면과 조사 모니터를 관리합니다. 자료 범위와 실행 호스트 상태를 결과와 함께 확인합니다.",
    "category": "data",
    "brandColor": "#0F766E",
    "defaultPrompts": [
      "@finance 애플 공시를 찾아 근거가 있는 보고서로 저장해줘",
      "@finance 내 대시보드에서 위험 표를 맨 위로 옮겨줘",
      "@finance 관심 종목 조사 모니터를 만들고 지금 실행해줘"
    ]
  },
  "invocation": {
    "mention": "@finance",
    "implicit": "never",
    "standalone": true
  },
  "provides": {
    "skills": {
      "router": "skills/index/SKILL.md",
      "workflows": [
        "research",
        "portfolio",
        "planning",
        "report",
        "workspace",
        "monitor",
        "analyst"
      ]
    },
    "tools": [
      {
        "id": "finance",
        "capability": "data",
        "kind": "stdio",
        "command": "${node}",
        "args": [
          "${pluginDir}/bin/finance-server.cjs"
        ],
        "envKeys": [],
        "timeoutMs": 30000,
        "surface": {
          "name": "Finance 계산",
          "nameEn": "Finance calculations",
          "description": "명시한 가정의 재무 계획과 공급자 관측 기반 포트폴리오 계산",
          "descriptionEn": "Explicit planning scenarios and portfolio valuation from supplied provider observations",
          "category": "data",
          "brandColor": "#0F766E",
          "mark": "F"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "none",
    "shell": "deny"
  },
  "state": {
    "files": [],
    "assets": false
  },
  "native": {
    "apiVersion": 1,
    "entry": "runtime/index.cjs",
    "modules": [
      "research",
      "portfolio",
      "planning",
      "report"
    ]
  },
