{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-structural-biology",
  "name": "Agentlas Structural Biology",
  "version": "0.1.0",
  "builtin": false,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.cloud"
  },
  "keywords": [
    "protein structure",
    "PDB",
    "RCSB",
    "AlphaFold",
    "3D structure",
    "Mol*",
    "binding site",
    "ligand",
    "covalent inhibitor",
    "drug discovery",
    "ChEMBL",
    "IC50",
    "bioactivity",
    "clinical trials",
    "ClinicalTrials.gov",
    "단백질 구조",
