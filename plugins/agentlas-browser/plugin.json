{
  "schema": "agentlas.plugin/v2",
  "slug": "agentlas-browser",
  "name": "Agentlas Browser",
  "version": "1.0.0",
  "builtin": true,
  "publisher": {
    "name": "Agentlas",
    "url": "https://agentlas.cloud"
  },
  "surface": {
    "displayName": "Agentlas Browser",
    "displayNameKo": "Agentlas 브라우저",
    "tagline": "Drive the web with sessions you signed in to",
    "taglineKo": "직접 로그인한 세션으로 웹을 조작합니다",
    "description": "Drives a dedicated Agentlas Chrome over CDP. Sessions you sign in to inside Agentlas Chrome are reused; your personal Chrome profile is never copied. Exposes two surfaces over the same launcher: the real-login browser and a Playwright tool surface.",
    "descriptionKo": "Agentlas 전용 Chrome을 CDP로 조작합니다. Agentlas Chrome 안에서 직접 로그인한 세션을 재사용하며 개인 Chrome 프로필은 복사하지 않습니다. 같은 런처 위에 실제 로그인 브라우저와 Playwright 두 표면을 냅니다.",
    "category": "web",
    "brandColor": "#1D7E67",
    "icon": "assets/icon.svg",
    "defaultPrompts": [
      "이 페이지 열어서 지금 화면 캡처해줘",
      "로그인된 상태로 이 사이트 확인해줘"
    ]
  },
  "invocation": {
    "mention": "@browser",
    "implicit": "always",
    "standalone": true
  },
  "provides": {
    "tools": [
      {
        "id": "agentlas-browser",
        "capability": "browser",
        "kind": "builtin",
        "resolver": "browser-cdp",
        "envKeys": [],
        "timeoutMs": 120000,
        "form": "materialized",
        "contract": 2,
        "upstream": {
          "package": "@playwright/mcp",
          "resolution": "host-injected-at-materialize",
          "onMissing": "fail-loud"
        },
        "gate": "irreversible-actions",
        "recipes": {
          "dir": "~/.agentlas/browser-skills",
          "format": "agentlas.recipe/v1"
        },
        "surface": {
          "name": "Agentlas 브라우저 (실제 로그인)",
          "nameEn": "Agentlas Browser (real login)",
          "description": "Agentlas 전용 Chrome에서 사용자가 직접 로그인한 세션으로 웹 조작 (개인 Chrome 프로필은 복사하지 않음, 키 불필요)",
          "descriptionEn": "Drive the web with sessions you sign in to inside Agentlas Chrome; your personal Chrome profile is never copied (general, no key)",
          "category": "web",
          "brandColor": "#1D7E67",
          "mark": "AB",
          "docsUrl": "https://github.com/microsoft/playwright-mcp"
        },
        "hostChannels": [
          {
            "id": "approval",
            "env": "AGENTLAS_BROWSER_APPROVAL_FILE",
            "mode": "read-only"
          }
        ]
      },
      {
        "id": "playwright",
        "capability": "browser",
        "kind": "builtin",
        "resolver": "browser-cdp",
        "envKeys": [],
        "timeoutMs": 120000,
        "form": "materialized",
        "contract": 2,
        "upstream": {
          "package": "@playwright/mcp",
          "resolution": "host-injected-at-materialize",
          "onMissing": "fail-loud"
        },
        "gate": "irreversible-actions",
        "recipes": {
          "dir": "~/.agentlas/browser-skills",
          "format": "agentlas.recipe/v1"
        },
        "surface": {
          "name": "Playwright (브라우저)",
          "nameEn": "Playwright (browser)",
          "description": "실제 브라우저로 웹 탐색·클릭·입력·스크린샷 (컴퓨터 유즈, 키 불필요)",
          "descriptionEn": "Drive a real browser — navigate, click, type, screenshot (computer use, no key)",
          "category": "web",
          "brandColor": "#2EAD33",
          "mark": "PW",
          "docsUrl": "https://github.com/microsoft/playwright-mcp"
        }
      }
    ]
  },
  "requires": {
    "prereq": [
      {
        "id": "node",
        "provided-by": "app"
      },
      {
        "id": "chrome",
        "provided-by": "app",
        "note": "dedicated Agentlas profile, launched with a remote debugging port"
      }
    ],
    "os": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "permissions": {
    "fileWrite": "none",
    "network": "allow",
    "shell": "deny"
  },
  "state": {
    "files": [],
    "assets": false
  }
}
