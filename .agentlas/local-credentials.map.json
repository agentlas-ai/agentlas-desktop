{
  "schemaVersion": "1.0",
  "kind": "agentlas-local-credential-store",
  "projectName": "agentlas_desktop",
  "projectRoot": ".",
  "envFiles": [".env", ".env.local"],
  "secretDirs": ["signing", "credentials"],
  "entries": [
    {
      "id": "desktop-macos-release-signing",
      "provider": "apple_developer",
      "env": [],
      "localFiles": ["signing/"],
      "owner": "project",
      "valueMaterialized": false,
      "storage": ["project_file", "keychain_or_notary_profile"],
      "requiredFor": ["macos_release"],
      "lastVerified": null,
      "staleCheck": "Run release readiness and signing verification before publishing."
    }
  ]
}
