# Rebuilt from native/macos/AgentlasInputDriver.swift for each macOS package.
/build-resources/native/macos/agentlas-input-driver
/build-resources/native/macos/.build-*

# Fetched CPython runtime (scripts/fetch-python-runtime.mjs writes the tree +
# manifest deterministically from its pinned version). It is a build cache, not
# source; only .gitkeep is tracked so the directory exists for the fetcher.
/build-resources/python-runtime/*
!/build-resources/python-runtime/.gitkeep

# Official Node.js runtime fetched only for the Windows no-Node CLI bootstrap.
# Keep the immutable fetcher/manifest contract in git, never the large runtime tree.
/build-resources/node-runtime/*
!/build-resources/node-runtime/.gitkeep
/build-resources/browser-runtime/*
!/build-resources/browser-runtime/.gitkeep

# Local visual QA evidence is never source or release material.
/.artifacts/
/.sei/
/scripts/validate-automation-session-clone.cjs
/scripts/validate-task-participant-repair-clone.cjs
/scripts/test-run-event-task-participants.cjs

# Agentlas One local QA harnesses and generated context maps. They are kept on
# disk for the live audit but are not product or release inputs.
agentlas-context-map.json
scripts/graph-runtime-permission-contract.cjs
scripts/one-*-contract.*
scripts/one-real-chat-qa-report.cjs
scripts/one-session-qa-scenarios.cjs
scripts/ontology-retirement-contract.mjs
scripts/qa-one-decision-receipt-freshness.cjs

# Tests are local-only (owner decision, 2026-07-26). CI builds, signs, and
# publishes; it never runs a suite. Run them here before pushing:
#   npm run test:<name>   /   electron scripts/test-<name>.cjs
# Release machinery stays tracked: scripts/*.mjs, scripts/release-*.mjs.
scripts/test-*.cjs
scripts/verify-*.cjs
# 점으로 시작하는 scripts/ 파일은 **한 번 쓰고 버리는 시험 하네스**다(캠페인 드라이버 등).
# 이 저장소는 공개다. 누군가 blanket add 를 하면 하네스가 그대로 공개되는데, 하네스는
# 사용자가 설치·실행하는 데 필요한 것이 아니다. 실측 2026-08-20: 이런 파일이 32개
# 추적 밖에 쌓여 있었고, 무시 규칙은 하나도 걸려 있지 않았다.
scripts/.*
scripts/lib/mock-*.cjs
scripts/fixtures/
# Exceptions: these two are packaging machinery, not suites. package-mac.sh and
# the cross-platform build run them against the built artifact, so CI must have
# them or packaging fails with file-not-found.
!scripts/verify-packaged-workforce-runtime.cjs
# The Windows/Linux updater E2E is the one check that cannot run on this Mac, so
# it stays in CI and the runner sparse-checks this exact file out of the release
# commit. It drives the built installer, not product internals.
!scripts/verify-packaged-updater-install-e2e.cjs

# session scratch/demo (never publish)
scripts/capture-x-graph.cjs
scripts/demo/

# Local QA drivers for the Build surface. These pilot the running app over CDP
# with a test account and are worthless to anyone else — they name this
# machine's scratch paths and grants.
/qa-*.mjs
/renderer/qa-*.mjs
/run-queue.sh

# Generated from the pinned maplibre-gl package before renderer dev/build.
/renderer/public/vendor/maplibre-gl/

# Generated from the pinned File Viewer dependency graph before renderer dev/build.
/renderer/public/file-viewer/

# Apple HIG page text is Apple's copyright and this repo is public — the design
# plugin keeps it as a local cache only (refill: node scripts/fetch-apple-hig.mjs).
plugins/design/references/apple-hig/.cache/
