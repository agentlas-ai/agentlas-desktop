dist/
/out/
/build/
.next/
renderer/.next/
renderer/out/
*.tsbuildinfo

# Electron-builder
release/
*.dmg
*.app
*.exe
*.AppImage

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# local env
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
._*
