# ── Embedded engine (separate open-source repo) ──────────────────────────────
# Hephaestus is its own public repo (github.com/agentlas-ai/Hephaestus). It is
# embedded into the desktop build at PACKAGE time via electron-builder
# `extraResources` (filesystem copy, independent of git), NOT tracked here.
# This keeps the private desktop repo free of the engine source while still
# shipping the engine inside the .app. Engine must be present on disk to build.
/Hephaestus/
# Sibling agent-forge working tree (not shipped)
/Hephaestus_agent_forge/

# Root-level scratch / one-off scripts (not part of the app)
/clean_settings.py
/fix_settings.py
/make_collapsible.py
/test_wrap.py
/fix.js
/rewrite_panels.js
/rewrite_safe.js
/rewrite_settings.js
/renderer/app/(shell)/library/agents/transform.js
*.bak

# Embedded Startup Founder Studio package (bundled at build). Keep runtime/private
# data out, but track the sanitized launcher + built SPA so clean CI can package.
/studio-pack/.agentlas/
/studio-pack/.studio-runtime/
/studio-pack/**/__pycache__/
/studio-pack/**/*.pyc
/studio-pack/node_modules/
/studio-pack/web/node_modules/
/studio-pack/web/dist/generated/
/studio-pack/web/dist/studio-data.json
/studio-pack/web/public/generated/
/studio-pack/web/public/studio-data.json
/studio-pack/docs/dogfood/**/stitch/generated/

# Heavy T-rex sample/capture images — regenerated locally, never shipped
renderer/public/trex-samples/

