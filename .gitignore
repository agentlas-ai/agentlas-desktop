*.jks
*.keystore

# Agentlas architecture: ignore volatile runtime memory, keep curated soul/sitemap
.agentlas/memory-log.jsonl
# Generated AI code-map (produced by the code-map tool background gen — not source)
.agentlas/code-map/
._*

# local packaging output (large)
release-local/
# large demo/verification outputs
artifacts/
evidence/
# generated Playwright QA screenshots/reports
output/playwright/
# Local visual research can contain browser chrome or account-identifying text.
/output/reference-video-frames/
/output/actual-live-ontology/
/output/experience-chip-management-ko.png
/findings/

# Internal working documents are local-only. Public product documentation is
# explicitly allow-listed below; new plans, PRDs, research, QA receipts, and
# private screenshots under docs/ must never enter a release commit.
/docs/**
!/docs/ARCHITECTURE.md
!/docs/ARCHITECTURE_PLAYBOOK.md
!/docs/M0-CHECKLIST.md
!/docs/PUBLIC-RELEASE.md
!/docs/AGENT_VISIBILITY_CONTRACT.md
!/docs/UPDATER_RECOVERY_CONTRACT.md
!/docs/cloud-agent-framework.md
!/docs/document-studio.md
!/docs/generated-app-engine.md
!/docs/menu-action-contract.md
!/docs/system-agents-architecture.md
!/docs/screenshot.png

# Other conventional local-only document roots and root-level PM receipts.
/internal/
/.internal/
/private-docs/
/plans/
/research/
/reports/
/receipts/
/notes/
/qa/
/*_INTERNAL*.md
/*_LEDGER*.md
/*_RECEIPT*.md
/*_RESEARCH*.md
/*_PLAN*.md
/*_NOTES*.md

# ── Embedded engine (separate open-source repo) ──────────────────────────────
# Hephaestus is its own public repo (github.com/agentlas-ai/Hephaestus). It is
# embedded into the desktop build at PACKAGE time via electron-builder
# `extraResources` (filesystem copy, independent of git), NOT tracked here.
# This keeps the private desktop repo free of the engine source while still
# shipping the engine inside the .app. Engine must be present on disk to build.
/Hephaestus/
# Sibling agent-forge working tree (not shipped)
/Hephaestus_agent_forge/

# Root-level scratch / one-off scripts (not part of the app)
/clean_settings.py
/fix_settings.py
/make_collapsible.py
/test_wrap.py
/fix.js
/rewrite_panels.js
/rewrite_safe.js
/rewrite_settings.js
/renderer/app/(shell)/library/agents/transform.js
*.bak

# Embedded Startup Founder Studio package (bundled at build). Keep runtime/private
# data out, but track the sanitized launcher + built SPA so clean CI can package.
/studio-pack/.agentlas/
/studio-pack/.studio-runtime/
/studio-pack/**/__pycache__/
/studio-pack/**/*.pyc
/studio-pack/node_modules/
/studio-pack/web/node_modules/
/studio-pack/web/dist/generated/
/studio-pack/web/dist/studio-data.json
/studio-pack/web/public/generated/
/studio-pack/web/public/studio-data.json
/studio-pack/docs/dogfood/**/stitch/generated/

# Heavy T-rex sample/capture images — regenerated locally, never shipped
renderer/public/trex-samples/
