dist/
/out/
/build/
.next/
renderer/.next/
renderer/.next-build/
renderer/out/
*.tsbuildinfo

# Electron-builder
release/
*.dmg
*.app
*.exe
*.AppImage

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

