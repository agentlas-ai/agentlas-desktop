# <<< agentlas local project state <<<

# Agentlas local credentials and signing material never enter public commits.
.env
.env.local
.env.*.local
._*
signing/
credentials/
.agentlas/ontology-runtime.sqlite*
.agentlas/career-graph.sqlite*
