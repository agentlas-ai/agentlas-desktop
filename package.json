    "@rive-app/canvas": "^2.40.1",
    "@xyflow/react": "^12.11.1",
    "agentlas-science": "git+ssh://git@github.com/agentlas-ai/agentlas-science.git#2abeef85112ddcaa847046b98f9cfd8135c3c54e",
    "beautiful-mermaid": "^1.1.3",
    "better-sqlite3": "^12.11.1",
    "croner": "^9.1.0",
    "cross-spawn": "^7.0.6",
    "cytoscape": "3.34.1",
    "d3": "7.9.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.3",
    "framer-motion": "12.42.2",
    "katex": "^0.18.4",
    "keytar": "^7.9.0",
    "maplibre-gl": "^6.5.0",
    "molstar": "5.11.0",
    "node-pty": "^1.1.0",
