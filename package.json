{
  "name": "agentlas-desktop",
  "version": "1.2.53",
  "description": "Agentlas Desktop — local Apps OS for AI-native tools and agent teams. BYOC: 사용자 Claude/ChatGPT/Antigravity 구독 그대로.",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/electron/entry.js",
  "author": "Agentlas",
  "homepage": "https://agentlas.cloud/desktop",
  "agentlasReleaseScope": {
    "desktop": true,
    "mobile": false
  },
  "agentlasUpdateCompatibility": {
    "minimumSourceAppVersion": "0.7.0",
    "minimumRuntimeVersion": "1.0.4",
    "minimumSchemaVersion": 35,
    "targetSchemaVersion": 126,
    "bundledRuntimeVersion": "1.2.51"
  },
  "agentlasBundledRuntimeSource": {
    "repository": "https://github.com/agentlas-ai/Agentlas-OS.git",
    "ref": "v1.2.51",
    "commit": "4ca8fd28d5ad9a92cbe33b39d05bcff8febe7448",
    "assetName": "hephaestus-runtime-v1.2.51.tar.gz",
    "assetSha256": "0f95c8844fd9793285ac41031eea1ed4f98dba3a10707918f7cdcd74230bc1f3"
  },
  "scripts": {
    "dev": "concurrently -k --success first -n NEXT,ELECTRON -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm run --silent sync:renderer-assets && cd renderer && next dev -p 3100",
    "dev:electron": "wait-on http://localhost:3100 && node scripts/build-macos-input-driver.cjs && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3100 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm run --silent sync:renderer-assets && cd renderer && cross-env AGENTLAS_NEXT_DIST_DIR=.next-build next build && node -e \"require('fs').cpSync('.next-build','../dist/renderer',{recursive:true})\"",
    "generate:one-briefing-contract": "node scripts/generate-one-briefing-contract.cjs",
    "check:one-briefing-contract": "node scripts/generate-one-briefing-contract.cjs --check",
    "build:electron": "npm run --silent check:one-briefing-contract && node scripts/build-macos-input-driver.cjs && tsc -p electron/tsconfig.json && node scripts/copy-builtin-plugins.cjs && node -e \"require('fs').copyFileSync('electron/memory/code-map-gen.mjs','dist/electron/memory/code-map-gen.mjs');require('fs').copyFileSync('electron/memory/curator-ruleset.json','dist/electron/memory/curator-ruleset.json');require('fs').copyFileSync('electron/mcp-tools/proxy-child.cjs','dist/electron/mcp-tools/proxy-child.cjs')\"",
    "prebuild:renderer": "node -e \"const fs=require('fs');['dist/renderer','renderer/.next-build','renderer/out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true,maxRetries:5,retryDelay:100}))\"",
    "postinstall": "electron-rebuild --force",
    "sync:renderer-assets": "npm run --silent sync:maplibre-worker && npm run --silent sync:file-viewer-assets",
    "sync:maplibre-worker": "node scripts/sync-maplibre-worker.cjs",
    "sync:file-viewer-assets": "node scripts/sync-file-viewer-assets.cjs",
    "ensure:engine": "node scripts/ensure-engine.mjs",
    "prepare:embedded-core": "node scripts/prepare-embedded-core.mjs",
    "daemon": "cross-env ELECTRON_RUN_AS_NODE=1 electron dist/electron/daemon/main.js",
    "fetch:python": "node scripts/fetch-python-runtime.mjs",
    "fetch:node": "node scripts/fetch-node-runtime.mjs",
    "fetch:browser": "node scripts/fetch-browser-runtime.mjs",
    "studio:seed": "node scripts/studio-clean-seed.mjs",
    "publish:cdn": "node scripts/publish-cdn.mjs",
    "package:mac": "npm run ensure:engine && bash scripts/package-mac.sh",
    "install:mac:stable": "bash scripts/install-stable-mac.sh",
    "dist:mac:unsigned": "bash scripts/package-mac.sh --clean-local-output && npm run ensure:engine && npm run build && npm run fetch:python && npm run fetch:node && npm run fetch:browser && AGENTLAS_LOCAL_CANDIDATE=1 electron-builder --mac --dir --publish never --config electron-builder.mac-local.yml && node scripts/verify-local-mac-candidate.mjs",
    "dist:win": "npm run ensure:engine && npm run build && npm run fetch:python && npm run fetch:node && npm run fetch:browser && electron-builder --win",
    "dist:linux": "npm run ensure:engine && npm run build && npm run fetch:python && npm run fetch:browser && electron-builder --linux",
    "release:mac:verify": "node scripts/verify-mac-release.mjs --write-env",
    "release:mac:candidate": "node scripts/verify-mac-release.mjs --write-env --allow-unnotarized",
    "release:assets:verify": "node scripts/verify-release-assets.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:csr": "bash scripts/create-apple-csr.sh",
    "release:p12": "bash scripts/create-p12-from-apple-cert.sh",
    "release:mac:publish": "node scripts/publish-mac-release.mjs",
    "release:mac:lineage": "node scripts/verify-mac-update-lineage.mjs",
    "release:web-env": "node scripts/apply-web-release-env.mjs",
    "release:railway:check": "node scripts/check-railway-release-access.mjs",
    "test:mac-install-transaction": "node scripts/verify-mac-install-boundary.mjs --self-test",
    "audit:automation": "node scripts/audit-automation-health.mjs --once",
    "watch:automation": "node scripts/audit-automation-health.mjs",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && cd renderer && tsc --noEmit",
    "lint": "next lint --dir renderer",
    "clean": "node -e \"['dist','out','release','renderer/.next','renderer/out'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "workforce:source-failure-codes:gen": "node scripts/gen-workforce-source-failure-codes.cjs",
    "bump:engine": "node scripts/bump-bundled-engine.mjs",
    "check:engine-freshness": "node scripts/bump-bundled-engine.mjs --check",
    "graph:registry:gen": "node scripts/gen-graph-registry.cjs",
    "graph:map": "node scripts/gen-graph-map.cjs",
    "build:model-catalog-snapshot": "node scripts/build-model-catalog-snapshot.cjs",
    "verify:packaging-completeness": "node scripts/verify-packaging-completeness.mjs"
  },
  "dependencies": {
    "@file-viewer/preset-lite": "^2.3.0",
