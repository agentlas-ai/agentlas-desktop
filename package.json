{
  "name": "agentlas-desktop",
  "version": "0.7.18",
  "description": "Agentlas Desktop — local Apps OS for AI-native tools and agent teams. BYOC: 사용자 Claude/ChatGPT/Gemini 구독 그대로.",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/electron/main.js",
  "author": {
    "name": "Agentlas",
    "email": "appbridge@appbridge.co.kr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentlas-ai/agentlas-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/agentlas-ai/agentlas-desktop/issues"
  },
  "homepage": "https://agentlas.cloud/desktop",
  "scripts": {
    "dev": "concurrently -k --success first -n NEXT,ELECTRON -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "cd renderer && next dev -p 3100",
    "dev:electron": "wait-on http://localhost:3100 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3100 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "cd renderer && next build && node -e \"require('fs').cpSync('out','../dist/renderer',{recursive:true})\"",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').copyFileSync('electron/memory/code-map-gen.mjs','dist/electron/memory/code-map-gen.mjs')\" && node scripts/gen-cli-architecture.mjs",
    "gen:cli-arch": "node scripts/gen-cli-architecture.mjs",
    "prebuild:renderer": "node -e \"const fs=require('fs');['dist/renderer','renderer/.next','renderer/out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true,maxRetries:5,retryDelay:100}))\"",
    "postinstall": "electron-rebuild --force",
    "ensure:engine": "node scripts/ensure-engine.mjs",
    "fetch:python": "node scripts/fetch-python-runtime.mjs",
    "studio:seed": "node scripts/studio-clean-seed.mjs",
    "publish:cdn": "node scripts/publish-cdn.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "package:mac": "npm run ensure:engine && bash scripts/package-mac.sh",
    "install:mac:stable": "bash scripts/install-stable-mac.sh",
    "dist:mac:unsigned": "npm run ensure:engine && npm run build && electron-builder --mac -c.mac.notarize=false -c.mac.identity=null",
    "dist:win": "npm run ensure:engine && npm run build && electron-builder --win",
    "dist:linux": "npm run ensure:engine && npm run build && electron-builder --linux",
    "release:mac:verify": "node scripts/verify-mac-release.mjs --write-env",
    "release:mac:candidate": "node scripts/verify-mac-release.mjs --write-env --allow-unnotarized",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:csr": "bash scripts/create-apple-csr.sh",
    "release:p12": "bash scripts/create-p12-from-apple-cert.sh",
    "release:mac:publish": "node scripts/publish-mac-release.mjs",
    "release:web-env": "node scripts/apply-web-release-env.mjs",
    "release:railway:check": "node scripts/check-railway-release-access.mjs",
    "qa:committee": "node scripts/committee-gate.mjs",
    "smoke:app-factory": "npm run build:electron && electron scripts/smoke-app-factory.cjs",
    "test:app-builder-routing": "npm run build:electron && node scripts/test-app-builder-routing.cjs",
    "test:app-builder-seed": "npm run build:electron && electron scripts/test-app-builder-seed.cjs",
    "test:super-ontology-seed": "npm run build:electron && node scripts/test-super-ontology-seed.cjs",
    "test:cloud-app-manifest": "npm run build:electron && electron scripts/test-cloud-app-manifest.cjs",
    "test:cloud-agent-package": "npm run build:electron && electron scripts/test-cloud-agent-package.cjs",
    "test:marketplace-hub-only": "npm run build:electron && electron scripts/test-marketplace-hub-only.cjs",
    "test:marketplace-cache": "npm run build:electron && electron scripts/test-marketplace-cache.cjs",
    "test:mcp-auto-select": "npm run build:electron && electron scripts/test-mcp-auto-select.cjs",
    "test:agent-groups": "npm run build:electron && electron scripts/test-agent-groups.cjs",
    "test:borrowed-task-force": "npm run build:electron && electron scripts/test-borrowed-task-force.cjs",
    "test:studio-start": "npm run build:electron && electron scripts/test-studio-start.cjs",
    "test:automations-store": "npm run build:electron && electron scripts/test-automations-store.cjs",
    "audit:automation": "node scripts/audit-automation-health.mjs --once",
    "watch:automation": "node scripts/audit-automation-health.mjs",
    "test:cli-image-attachments": "npm run build:electron && node scripts/test-cli-image-attachments.cjs",
    "test:desktop-feature-surfaces": "npm run build:renderer && node scripts/test-desktop-feature-surfaces.cjs",
    "test:agentlas-cloud-runtime": "node scripts/test-agentlas-cloud-runtime.cjs",
    "test:ontology-repl": "node scripts/test-ontology-repl.cjs",
    "smoke:app-autopilot": "npm run build:electron && electron scripts/smoke-app-autopilot.cjs",
    "smoke:agent-os-handsfree": "npm run build:electron && electron scripts/smoke-agent-os-handsfree.cjs",
    "smoke:chat-local-agent-os": "npm run build:electron && electron scripts/smoke-chat-local-agent-os.cjs",
    "smoke:chat-local-creative-os": "npm run build:electron && electron scripts/smoke-chat-local-creative-os.cjs",
    "proof:chat-local-agent-os": "npm run build:electron && electron scripts/proof-chat-local-agent-os.cjs",
    "proof:chat-local-creative-os": "npm run build:electron && electron scripts/proof-chat-local-creative-os.cjs",
    "proof:electron-chat-agent-os": "npm run build && node scripts/proof-electron-chat-agent-os.cjs",
    "smoke:tool-factory": "npm run build:electron && electron scripts/smoke-tool-factory.cjs",
    "smoke:surface-assets": "npm run build:electron && node scripts/smoke-surface-assets.cjs",
    "smoke:creative-pack": "npm run build:electron && node scripts/smoke-creative-pack.cjs",
    "smoke:creative-durable": "npm run build:electron && electron scripts/smoke-creative-durable.cjs",
    "proof:creative-agent-os": "npm run build:electron && electron scripts/proof-creative-agent-os.cjs",
    "smoke:ecommerce-agent-os": "npm run build:electron && electron scripts/smoke-ecommerce-agent-os.cjs",
    "proof:ecommerce-agent-os": "npm run build:electron && electron scripts/proof-ecommerce-agent-os.cjs",
    "smoke:surface-jobs": "npm run build:electron && node scripts/smoke-surface-jobs.cjs",
    "smoke:surface-state": "npm run build:electron && node scripts/smoke-surface-state.cjs",
    "smoke:surface": "npm run build:electron && node scripts/smoke-surface-emitter.cjs",
    "smoke:multimodal": "npm run build:electron && node scripts/smoke-multimodal-settings.cjs",
    "smoke:oberon-motion": "npm run build:electron && electron scripts/smoke-oberon-motion-ad.cjs",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && node -e \"require('fs').rmSync('renderer/.next',{recursive:true,force:true,maxRetries:5,retryDelay:100})\" && cd renderer && tsc --noEmit",
    "lint": "next lint --dir renderer",
    "clean": "node -e \"['dist','out','release','renderer/.next','renderer/out'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@xyflow/react": "^12.11.1",
    "better-sqlite3": "^11.3.0",
    "croner": "^9.1.0",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.7",
    "next": "^15.0.0",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
