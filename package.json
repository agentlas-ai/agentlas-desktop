    "tar": "^7.5.22",
    "@electron/get": {
      "undici": "7.29.1"
    },
    "node-gyp": {
      "undici": "6.28.1"
    },
    "ip-address": "10.7.2",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "hono": ">=4.13.5 <5.0.0",
    "fflate": "^0.8.3",
    "joi": ">=18.2.5 <19.0.0",
    "qs": ">=6.16.0 <7.0.0",
    "plist": {
      "@xmldom/xmldom": "0.8.15"
    }
  },
  "agentlasInstallIdentity": {
    "schemaVersion": 1,
    "channel": "official",
    "appId": "com.agentlas.desktop",
    "appName": "Agentlas",
    "userDataNamespace": "Agentlas",
    "keychainService": "com.agentlas.desktop",
    "updateFeed": "official"
  }
