  "scripts": {
    "dev": "concurrently -k --success first -n NEXT,ELECTRON -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm run --silent sync:renderer-assets && cd renderer && next dev -p 3100",
    "dev:electron": "wait-on http://localhost:3100 && node scripts/build-macos-input-driver.cjs && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:3100 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "npm run --silent sync:renderer-assets && cd renderer && cross-env AGENTLAS_NEXT_DIST_DIR=.next-build next build && node -e \"require('fs').cpSync('.next-build','../dist/renderer',{recursive:true})\"",
    "generate:one-briefing-contract": "node scripts/generate-one-briefing-contract.cjs",
    "check:one-briefing-contract": "node scripts/generate-one-briefing-contract.cjs --check",
    "build:electron": "npm run --silent check:one-briefing-contract && node scripts/build-macos-input-driver.cjs && tsc -p electron/tsconfig.json && node scripts/copy-builtin-plugins.cjs && node -e \"require('fs').copyFileSync('electron/memory/code-map-gen.mjs','dist/electron/memory/code-map-gen.mjs');require('fs').copyFileSync('electron/memory/curator-ruleset.json','dist/electron/memory/curator-ruleset.json');require('fs').copyFileSync('electron/mcp-tools/proxy-child.cjs','dist/electron/mcp-tools/proxy-child.cjs')\"",
    "prebuild:renderer": "node -e \"const fs=require('fs');['dist/renderer','renderer/.next-build','renderer/out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true,maxRetries:5,retryDelay:100}))\"",
    "postinstall": "electron-rebuild --force",
    "sync:renderer-assets": "npm run --silent sync:maplibre-worker && npm run --silent sync:file-viewer-assets",
    "sync:maplibre-worker": "node scripts/sync-maplibre-worker.cjs",
    "sync:file-viewer-assets": "node scripts/sync-file-viewer-assets.cjs",
    "ensure:engine": "node scripts/ensure-engine.mjs",
    "prepare:embedded-core": "node scripts/prepare-embedded-core.mjs",
    "daemon": "cross-env ELECTRON_RUN_AS_NODE=1 electron dist/electron/daemon/main.js",
    "probe:runtime-capabilities": "node scripts/probe-runtime-capabilities.mjs --check",
