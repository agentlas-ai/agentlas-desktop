    "typescript": "^5.6.2",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3",
    "vite": "8.2.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "postcss": "8.5.23",
