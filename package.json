    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.173.0",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
