#!/bin/sh
set -eu

pushes_release_tag=0

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/main)
      ;;
    refs/tags/v*)
      # A zero local object ID is a tag deletion, which has nothing to verify.
      case "$local_oid" in
        ''|*[!0]*) pushes_release_tag=1 ;;
      esac
      ;;
    refs/heads/*)
      # A zero local object ID means this is an authorized branch deletion.
      case "$local_oid" in
        ''|*[!0]*)
          echo "Agentlas main-only guard: refusing push to $remote_ref" >&2
          echo "Only main and intentional tags may be pushed." >&2
          exit 1
          ;;
      esac
      ;;
  esac
done

# A release tag is the one push that CI answers for twenty minutes later, and
# the release contract is deterministic enough to answer here in under a minute.
# It went unrun locally for a long time because it reads the pinned runtime out
# of ./Hephaestus — a working checkout that drifts from the pin — and so failed
# for reasons unrelated to the change under test. release:preflight resolves the
# pin into an immutable cache instead, which is what makes this gate trustworthy
# enough to block on. See scripts/release-preflight.mjs.
if [ "$pushes_release_tag" = "1" ] && [ "${AGENTLAS_SKIP_RELEASE_PREFLIGHT:-0}" != "1" ]; then
  echo "[pre-push] release tag detected — verifying the release contract"
  if ! npm run --silent release:preflight; then
    echo "" >&2
    echo "[pre-push] Refusing to push this release tag: the release contract fails." >&2
    echo "           CI would fail the macOS and Linux gates the same way." >&2
    echo "           Fix it, move the tag, and push again — or set" >&2
    echo "           AGENTLAS_SKIP_RELEASE_PREFLIGHT=1 to override deliberately." >&2
    exit 1
  fi
fi

exit 0
